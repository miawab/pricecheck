# Copy this file to .env and fill it in. .env is never committed.

# Required: free key from https://ux.priorlabs.ai (accept the license on the Licenses tab first)
TABPFN_TOKEN=

# Optional: compare with what shops charge for the same model (free plan at serpapi.com, 250 searches/month)
# SERPAPI_KEY=

# Optional: Sentry agent tracing (each price check as an agent run with its Gemma and TabPFN steps).
# Create a Python/FastAPI project at sentry.io and paste its DSN here.
# SENTRY_DSN=

# Optional: a smaller Gemma for weaker PCs (default gemma4:e4b-it-qat, about 6 GB)
# PRICECHECK_MODEL=gemma4:e2b-it-qat

# Optional: open a GitLab issue automatically when OLX changes its pages (starts the self-healing flow).
# GITLAB_TOKEN = a personal access token with the `api` scope; GITLAB_PROJECT = the project's path.
# GITLAB_TOKEN=
# GITLAB_PROJECT=gitlab-ai-hackathon/transcend-october-2026/43397568/showcase
